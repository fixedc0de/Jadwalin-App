<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.Jadwalin" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/ios_accent</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Background & Surface colors -->
        <item name="android:colorBackground">@color/ios_bg</item>
        <item name="colorSurface">@color/ios_group_bg</item>
        <item name="colorOnSurface">@color/ios_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/ios_text_secondary</item>
        <item name="colorOutlineVariant">@color/ios_divider</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/ios_bg</item>
        <!-- windowLightStatusBar=true means dark icons (for light background) -->
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/ios_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Theme khusus untuk Full-Screen Alarm Activity (Selalu Gelap) -->
    <style name="Theme.Jadwalin.Alarm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Jadwalin.TimePicker" parent="Theme.Material3.DayNight">
        <item name="android:textColorPrimary">@color/ios_text_primary</item>
        <item name="android:editTextColor">@color/ios_text_primary</item>
        <item name="android:numbersTextColor">@color/ios_text_primary</item>
        <item name="android:textColorSecondary">@color/ios_text_secondary</item>
    </style>

    <style name="Theme.Jadwalin.BottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Jadwalin.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Widget.Jadwalin.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/ios_bg</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Jadwalin.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Jadwalin.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>
